# Copy to .env.local and fill in. Never commit real keys.

# --- Network (testnet = Solana devnet + Base Sepolia + NEAR testnet)
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=bagyard.testnet
NEXT_PUBLIC_MPC_SIGNER=v1.signer-prod.testnet
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEAR_RPC_URL=https://test.rpc.fastnear.com

# --- Sexton (relayer + coroner). Required for burials, raises and the séance.
# Generate with: npx tsx scripts/init-sexton-keys.ts <near-account> <near-credentials.json>
SEXTON_NEAR_ACCOUNT=
SEXTON_NEAR_PRIVATE_KEY=
SEXTON_SOLANA_SECRET=
SEXTON_EVM_PRIVATE_KEY=

# --- RPCs (public defaults work; set your own for reliability)
SOLANA_RPC_URL=
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Optional free-tier keys that make Base mainnet wallet scans reliable
# (keyless Blockscout is sometimes behind a Cloudflare challenge)
BLOCKSCOUT_API_KEY=
ALCHEMY_API_KEY=
